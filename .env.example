# ====== WAJIB ======
# Neon pooled connection (pakai endpoint -pooler, tambahkan pgbouncer=true)
# Contoh: postgresql://user:pass@ep-cool-name-pooler.ap-southeast-1.aws.neon.tech/sinilai?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/sinilai?pgbouncer=true&sslmode=require"

# Neon direct connection (untuk `prisma db push` / migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/sinilai?sslmode=require"

# Random string minimal 32 karakter: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-random-string-minimal-32-karakter"
